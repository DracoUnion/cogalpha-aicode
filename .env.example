# CogAlpha environment configuration
# Copy to `.env` and fill in. All vars also work as COGALPHA_* env vars.

# OpenAI API key (or export OPENAI_API_KEY)
COGALPHA_API_KEY=sk-...

# Optional: OpenAI-compatible base URL (for proxies/gateways)
COGALPHA_BASE_URL=

# Models
COGALPHA_MODEL=gpt-4o-mini
COGALPHA_QUALITY_MODEL=gpt-4o-mini
COGALPHA_MAX_TOKENS=4096

# Population / evolution
COGALPHA_INITIAL_POOL_SIZE=80
COGALPHA_PARENT_POOL_SIZE=32
COGALPHA_CHILD_POOL_SIZE=96
COGALPHA_NUM_PER_REQUEST=4
COGALPHA_EVOLUTION_SEARCHES=3
COGALPHA_GENERATIONS_PER_SEARCH=24
